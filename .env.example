# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Modelli. Il primo serve conversazione e memoria (turni brevi e frequenti),
# il secondo consolidamento e innesto (una volta al giorno, ma decidono cosa
# il sistema si ricorda per settimane). Lascia stare i default se hai dubbi.
CLAUDE_MODEL_FAST=claude-haiku-4-5
CLAUDE_MODEL_DEEP=claude-sonnet-4-6

# Postgres. Su Vercel: Storage → Create Database → Neon; la variabile viene
# iniettata da sola nel progetto e non devi copiarla a mano.
POSTGRES_URL=postgres://...

# Spotify — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Deve combaciare CARATTERE PER CARATTERE con quello registrato sulla dashboard.
# Spotify non accetta più "localhost": in locale usa il loopback esplicito,
# in produzione https. Es: https://<tuo-dominio>.vercel.app/api/spotify/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback

# Protegge le route cron. Su Vercel viene inviato come Authorization: Bearer <CRON_SECRET>;
# lo stesso valore va nei secret GitHub, che è da lì che parte lo scrobble.
CRON_SECRET=

# Unico proprietario dell'istanza
OWNER_ID=nic
